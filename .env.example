# KrishiRAG local development environment — TEMPLATE
# Copy to .env and fill in real values. NEVER commit .env.

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://krishirag:krishirag@localhost:5432/krishirag

# ── Vector store ───────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agricultural_knowledge

# ── LLM gateway ───────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
LLM_MODEL=qwen/qwen3.8-27b  # best available on Groq free tier
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ── Embeddings (local ONNX — no API key needed) ────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Admin (bearer token for ingestion endpoint) ────────────────────────────
ADMIN_TOKEN=local-dev-admin-token
